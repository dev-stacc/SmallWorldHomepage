# Palette and typography. base09-base0F are deliberately absent: the UI only
# ever reads these nine slots.
THEME_BASE00=0e0202
THEME_BASE01=000000
THEME_BASE02=ff4050
THEME_BASE03=5ef6ff
THEME_BASE04=ffe44d
THEME_BASE05=ffffff
THEME_BASE06=6abf24
THEME_BASE07=7a1f28
THEME_BASE08=8fdf4a
THEME_DISPLAY_FONT=Neuromax
THEME_MONO_FONT=Departure Mono
THEME_NUMERIC_FONT=Departure Mono
THEME_FONT_SIZE=11
THEME_NUMERIC_SIZE=15
THEME_TAB_SLOPE=24

# Unset, the app serves the bundled dummy data and makes no outbound request.
# FIXTURES=0 turns that off, and every page then reports its missing source.
# FIXTURES=0

# Point these at a collector, a config file and agents to replace the dummy
# data. CONFIG_PATH must be absolute. `npm run mock` and `npm run mock:agents`
# serve the fixtures over HTTP if you want to exercise these paths locally.
# COLLECTOR_URL=http://127.0.0.1:9847
# CONFIG_PATH=/absolute/path/to/config.json
# AGENT_TOKEN=
